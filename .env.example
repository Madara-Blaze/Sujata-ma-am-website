# Data source: "seed" (default, works with zero config) or "supabase".
DATA_SOURCE=seed

# The real production domain, once one is picked — used for canonical URLs
# and metadata. Leave unset locally; falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Supabase (optional — only needed when DATA_SOURCE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments / email (optional, wired for later — not used by the interface yet)
STRIPE_SECRET_KEY=
RESEND_API_KEY=
